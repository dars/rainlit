{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rainlit-cafe",
  "compatibility_date": "2026-09-22",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "routes": [
    {
      "pattern": "rainlit.code4soul.dev",
      "custom_domain": true
    }
  ],
  "main": "worker/index.ts",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rainlit-game",
      "database_id": "0fabd31a-bf53-44be-be0d-5634d55eabe6",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "API_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 20,
        "period": 60
      }
    }
  ],
  "vars": {
    "ALLOWED_ORIGIN": "https://rainlit.code4soul.dev"
  }
}
